<JOBI name="JOBI.ACT_CHECK">
<HEADER state="1">
<Title/>
<ArchiveKey1/>
<ArchiveKey2/>
<OH_SubType/>
</HEADER>
<SCRIPT mode="1" state="1">
<MSCRI><![CDATA[:set &uc_crlf# = uc_crlf()
:set &varHnd# = prep_process_var(vara.sqli_act_check)
:if get_process_info(&varHnd#, ROWS) = 0
:  stop nomsg
:endif
:process &varHnd#
:   set &currentJob# = get_process_line(&varHnd#,2)
:   set &currentJobRunid# = get_process_line(&varHnd#,4)
:   set &currentJobStatus# = get_process_line(&varHnd#,3)
:   p &currentJob#, &currentJobRunid#, &currentJobStatus#
!: need to convert status to text
!: set &currentJobStatus# = get_var(VARA_JOB_STATES,&currentJobStatus#)
: set &paddedName# = str_pad("&currentJob#(RunID: &currentJobRUNID#)",,50,LEFT)
: PUT_ATT_APPEND CALL_TEXT = "&paddedName# --> Status(&currentJobStatus#)&uc_crlf#"
:endprocess]]></MSCRI>
</SCRIPT>
<DOCU_Docu state="1" type="text">
<DOC/>
</DOCU_Docu>
</JOBI>
