<VARA state="1">
<SQLI internal="YES">
<command.sql/>
<command.ora>SELECT
    eh_name,
    eh_status,
    eh_ah_idnr
FROM
    eh
WHERE
        to_char(eh_activationtime, 'YYYYMMDD HH:MM:SS') &lt; to_char(current_timestamp, 'YYYYMMDD HH:MM:SS')
    AND eh_status IN ( 1300, 1820 )</command.ora>
<command.db2/>
<command.postgres/>
<BindParams>
<row Lnr="OVB_Lnr" Value="OVB_Value" id="OVB_OH_Idnr"/>
</BindParams>
<resultformat/>
<infobar>U04002751 Attention: There is a variable-replacement restriction in case of security limits (SQLVAR_SECURITY_LEVEL)!</infobar>
</SQLI>
